# Container operation functions
cmd_exec() {
    local container="conjur"
    local env_args=()
    local exec_command=()
    local interactive=true
    
    # Get admin API key for authentication
    local api_key=$(docker compose exec -T conjur conjurctl role retrieve-key cucumber:user:admin 2>/dev/null | tr -d '\r')
    if [[ -n "$api_key" ]]; then
        env_args+=(-e "CONJUR_AUTHN_API_KEY=$api_key")
    fi
    
    # Parse exec options
    while [[ $# -gt 0 ]]; do
        case $1 in
            --authn-oidc)
                echo -e "${BLUE}Enabling OIDC support...${NC}"
                enable_oidc
                shift
                ;;
            --authn-jwt)
                echo -e "${BLUE}Enabling JWT support...${NC}"
                enable_jwt
                shift
                ;;
            --authn-azure)
                echo -e "${BLUE}Enabling Azure support...${NC}"
                enable_azure
                shift
                ;;
            --authn-gcp)
                echo -e "${BLUE}Enabling GCP support...${NC}"
                handle_gcp "${@:2:4}"
                shift 5
                ;;
            --client)
                container="client"
                shift
                ;;
            -h|--help)
                print_exec_help
                return 0
                ;;
            --)
                # Everything after -- is the command to execute
                shift
                exec_command=("$@")
                interactive=false
                break
                ;;
            *)
                echo -e "${RED}Error: Unknown exec option '$1'${NC}"
                echo -e "${YELLOW}Use './conjur-dev exec --help' for usage information.${NC}"
                return 1
                ;;
        esac
    done
    
    if [[ ${#exec_command[@]} -gt 0 ]]; then
        # Execute command non-interactively
        echo -e "${BLUE}Executing command in $container container: ${exec_command[*]}${NC}"
        docker exec "${env_args[@]}" "$(docker compose ps -q "$container")" "${exec_command[@]}"
    else
        # Enter interactive shell
        echo -e "${BLUE}Entering $container container...${NC}"
        docker exec "${env_args[@]}" -it --detach-keys 'ctrl-\' "$(docker compose ps -q "$container")" bash
    fi
}

cmd_key() {
    docker compose exec -T conjur conjurctl role retrieve-key cucumber:user:admin 2>/dev/null | tr -d '\r'
}

cmd_policy_load() {
    local account="$1"
    local policy_file="$2"
    
    if [[ -z "$account" || -z "$policy_file" ]]; then
        echo -e "${RED}Error: Both account and policy file are required${NC}"
        echo -e "${YELLOW}Usage: ./cli policy load <account> <policy_file>${NC}"
        echo -e "${YELLOW}Policy file should be relative to the dev/ directory${NC}"
        return 1
    fi
    
    # Check if file exists locally (relative to current directory)
    if [[ -f "$policy_file" ]]; then
        echo -e "${BLUE}Loading policy '$policy_file' into account '$account'...${NC}"
        docker compose exec conjur conjurctl policy load "$account" "/src/conjur-server/$policy_file"
    else
        # Try container path directly (for files that exist only in container)
        echo -e "${BLUE}Loading policy '$policy_file' into account '$account' (container path)...${NC}"
        docker compose exec conjur conjurctl policy load "$account" "$policy_file"
    fi
}

