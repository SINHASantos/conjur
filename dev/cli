#!/bin/bash

# Conjur Development CLI
# Usage: ./cli [command] [options]

cd $(dirname "$0")

set -e

# Configuration
CONJUR_URL="http://localhost:3000"
CONJUR_ACCOUNT="cucumber"
ADMIN_USER="admin"
ALICE_USER="alice"

# API keys will be fetched dynamically
ADMIN_API_KEY=""
ALICE_API_KEY=""

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Global variables for tokens
ADMIN_TOKEN=""
ALICE_TOKEN=""

# Function to print section headers
print_section() {
    echo -e "\n${GREEN}=== $1 ===${NC}"
}

# Function to execute curl with nice formatting
execute_curl() {
    local description="$1"
    shift
    echo -e "\n${YELLOW}$description${NC}"
    echo "Command: curl $*"
    echo "Response:"
    curl -s "$@" | jq '.' 2>/dev/null || curl -s "$@"
    echo ""
}

# Function to execute curl with detailed output (headers, status, etc.)
execute_curl_detailed() {
    local description="$1"
    shift
    echo -e "\n${YELLOW}$description${NC}"
    echo "Command: curl -i $*"
    echo ""
    
    # Create temp files for response parts
    local response_file=$(mktemp)
    local headers_file=$(mktemp)
    
    # Execute curl with verbose output
    local http_code=$(curl -s -w "%{http_code}" -D "$headers_file" -o "$response_file" "$@")
    
    # Display HTTP status
    echo -e "${BLUE}HTTP Status: $http_code${NC}"
    
    # Display headers
    echo -e "\n${GREEN}Response Headers:${NC}"
    grep -v "^$" "$headers_file" | while IFS= read -r line; do
      echo "  $line"
    done
    
    # Display response body
    echo -e "\n${GREEN}Response Body:${NC}"
    if [[ -s "$response_file" ]]; then
        # Try to format as JSON first, fallback to plain text
        if jq '.' "$response_file" 2>/dev/null; then
            :  # jq succeeded
        else
            cat "$response_file"
        fi
    else
        echo "  (empty response)"
    fi
    
    # Cleanup
    rm -f "$response_file" "$headers_file"
    echo ""
}

# Function to get API key from Conjur container
get_api_key() {
    local user="$1"
    echo -e "${YELLOW}Fetching API key for $user from Conjur container...${NC}" >&2
    
    # Try to get the API key from the container
    local api_key=$(docker compose exec -T conjur conjurctl role retrieve-key "$CONJUR_ACCOUNT:user:$user" 2>/dev/null)
    if [[ $? -ne 0 ]]; then
        echo -e "${RED}Failed to retrieve API key for $user from container${NC}" >&2
        echo -e "${YELLOW}You may need to recreate the user or check container status${NC}" >&2
        return 1
    fi
    
    # Clean up the API key (remove debug output and whitespace)
    api_key=$(echo "$api_key" | tail -1 | tr -d '\r\n')
    echo "$api_key"
}

# Function to ensure we have API key for user
ensure_api_key() {
    local user="$1"
    
    # Check if we already have the key
    local current_key=""
    if [[ "$user" == "$ADMIN_USER" ]]; then
        current_key="$ADMIN_API_KEY"
    elif [[ "$user" == "$ALICE_USER" ]]; then
        current_key="$ALICE_API_KEY"
    fi
    
    if [[ -z "$current_key" ]]; then
        local api_key=$(get_api_key "$user")
        if [[ $? -eq 0 ]]; then
            # Set the variable
            if [[ "$user" == "$ADMIN_USER" ]]; then
                ADMIN_API_KEY="$api_key"
            elif [[ "$user" == "$ALICE_USER" ]]; then
                ALICE_API_KEY="$api_key"
            fi
            echo -e "${GREEN}✓ Got API key for $user${NC}"
        else
            return 1
        fi
    fi
}

# Function to get authentication token
get_token() {
    local user="$1"
    local api_key="$2"
    
    if [[ -z "$api_key" ]]; then
        echo -e "${RED}Error: API key is empty for user $user${NC}" >&2
        return 1
    fi
    
    
    local raw_token=$(curl -s -X POST "$CONJUR_URL/authn/$CONJUR_ACCOUNT/$user/authenticate" -d "$api_key")
    
    if [[ -z "$raw_token" ]]; then
        echo -e "${RED}Error: Failed to get authentication token for $user${NC}" >&2
        return 1
    fi
    
    echo "$raw_token" | base64 -w 0
}

# Server management functions
check_server_status() {
    if docker compose exec conjur pgrep -f conjurctl >/dev/null 2>&1; then
        return 0  # Server is running
    else
        return 1  # Server is not running
    fi
}

start_server() {
    echo -e "${YELLOW}Starting Conjur server...${NC}"
    
    # Check if we need full initialization
    if ! docker compose exec conjur test -f /tmp/conjur_initialized >/dev/null 2>&1; then
        echo -e "${YELLOW}Conjur not initialized. Running full setup...${NC}"
        echo -e "${BLUE}This will take a few minutes. You'll see the full initialization process:${NC}"
        echo ""
        
        # Run the proper start script for full initialization
        if ! ./start --no-enter; then
            echo -e "${RED}✗ Failed to initialize Conjur${NC}"
            return 1
        fi
        
        # Mark as initialized
        docker compose exec conjur touch /tmp/conjur_initialized
        echo -e "${GREEN}✓ Conjur initialized successfully${NC}"
    fi
    
    # Just start the server process (already initialized)
    docker compose exec -d conjur conjurctl server
    echo -e "${GREEN}Waiting for server to start...${NC}"

    if docker compose exec conjur conjurctl wait; then
        echo -e "${GREEN}✓ Server started successfully${NC}"
    else
        echo -e "${RED}✗ Server failed to start or is not responding${NC}"
        return 1
    fi
}

stop_server() {
    echo -e "${YELLOW}Stopping Conjur server...${NC}"
    if docker compose exec conjur pkill -f conjurctl >/dev/null 2>&1; then
        echo -e "${GREEN}✓ Server stopped${NC}"
    else
        echo -e "${YELLOW}Server was not running${NC}"
    fi
}

restart_server() {
    echo -e "${YELLOW}Restarting Conjur server...${NC}"
    stop_server
    sleep 2
    start_server
}

ensure_server_running() {
    if ! check_server_status; then
        echo -e "${YELLOW}Conjur server is not running. Starting it...${NC}"
        start_server
    fi
}

# Function to view logs
cmd_logs() {
    local log_file="../log/development.log"
    local follow=false
    local filter=""
    local lines=50
    local show_help=false
    
    # Parse log options
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                show_help=true
                shift
                ;;
            -f|--follow)
                follow=true
                shift
                ;;
            -n|--lines)
                if [[ "$2" == "all" ]]; then
                    lines="all"
                else
                    lines="$2"
                fi
                shift 2
                ;;
            --all)
                lines="all"
                shift
                ;;
            -all)
                echo -e "${RED}Error: Invalid option '-all'. Did you mean '--all'?${NC}" >&2
                echo -e "${YELLOW}Use './cli logs --help' for usage information.${NC}" >&2
                return 1
                ;;
            --http)
                filter="request_id"
                shift
                ;;
            --db)
                filter="Sequel::Postgres::Database"
                shift
                ;;
            --filter)
                filter="$2"
                shift 2
                ;;
            --grep)
                filter="$2"
                shift 2
                ;;
            -*)
                echo -e "${RED}Error: Unknown option '$1'${NC}" >&2
                echo -e "${YELLOW}Use './cli logs --help' for usage information.${NC}" >&2
                return 1
                ;;
            *)
                # Treat remaining args as filter patterns (for backward compatibility)
                if [[ -z "$filter" ]]; then
                    filter="$1"
                fi
                shift
                ;;
        esac
    done
    
    # Show help if requested
    if [[ "$show_help" == true ]]; then
        echo -e "${BLUE}Conjur Development CLI - Logs Command${NC}"
        echo ""
        echo "Usage: ./cli logs [options] [filter_pattern]"
        echo ""
        echo "Options:"
        echo "  -f, --follow             - Follow log output (like tail -f)"
        echo "  -n, --lines NUM          - Show last NUM lines (default: 50)"
        echo "  -n all, --lines all      - Show all lines"
        echo "  --all                    - Show all lines (same as -n all)"
        echo "  --filter PATTERN         - Filter logs by pattern"
        echo "  --grep PATTERN           - Same as --filter"
        echo "  -h, --help               - Show this help"
        echo ""
        echo "Preset Filters:"
        echo "  --http                   - Show only HTTP request logs"
        echo "  --db                     - Show only database query logs"
        echo ""
        echo "Examples:"
        echo "  ./cli logs                    - Show last 50 lines"
        echo "  ./cli logs -f --http          - Follow HTTP request logs"
        echo "  ./cli logs --db               - Show database query logs"
        echo "  ./cli logs INFO               - Show last 50 lines containing 'INFO'"
        echo "  ./cli logs -f DEBUG           - Follow logs, show only DEBUG messages"
        echo "  ./cli logs -n 100 ERROR       - Show last 100 lines containing 'ERROR'"
        echo "  ./cli logs --filter 'Started' - Custom filter pattern"
        return 0
    fi
    
    if [[ ! -f "$log_file" ]]; then
        echo -e "${YELLOW}No log file found at $log_file${NC}"
        echo -e "${BLUE}Start the server first with: ./cli start${NC}"
        return 1
    fi
    
    if [[ -n "$filter" ]]; then
        echo -e "${BLUE}Viewing Conjur logs (filtered by: ${YELLOW}$filter${BLUE})${NC}"
    else
        echo -e "${BLUE}Viewing Conjur logs${NC}"
    fi
    if [[ "$follow" == true ]]; then
        echo -e "${YELLOW}Following logs (Ctrl+C to exit)${NC}"
    fi
    if [[ "$lines" == "all" ]]; then
        echo -e "${YELLOW}Showing all lines${NC}"
    else
        echo -e "${YELLOW}Showing last $lines lines${NC}"
    fi
    echo ""
    
    # Execute command with proper piping
    if [[ -n "$filter" ]]; then
        if [[ "$follow" == true ]]; then
            tail -f "$log_file" | grep --color=auto "$filter"
        elif [[ "$lines" == "all" ]]; then
            grep --color=auto "$filter" "$log_file"
        else
            tail -n "$lines" "$log_file" | grep --color=auto "$filter"
        fi
    else
        if [[ "$follow" == true ]]; then
            tail -f "$log_file"
        elif [[ "$lines" == "all" ]]; then
            cat "$log_file"
        else
            tail -n "$lines" "$log_file"
        fi
    fi
}

